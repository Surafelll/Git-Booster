<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gitboster - Boost Your GitHub Activity</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .hero-section {
            padding: 100px 0;
            color: white;
            text-align: center;
        }
        .feature-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 30px;
            margin: 20px 0;
            transition: transform 0.3s ease;
        }
        .feature-card:hover {
            transform: translateY(-5px);
        }
        .btn-github {
            background: #333;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 18px;
            border-radius: 50px;
            transition: all 0.3s ease;
        }
        .btn-github:hover {
            background: #555;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }
        .navbar {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
        }
        .navbar-brand {
            font-weight: bold;
            font-size: 24px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fab fa-github"></i> Gitboster
            </a>
            <% if (user) { %>
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" href="/dashboard">Dashboard</a>
                    <a class="nav-link" href="/logout">Logout</a>
                </div>
            <% } %>
        </div>
    </nav>

    <div class="hero-section">
        <div class="container">
            <h1 class="display-4 mb-4">
                <i class="fab fa-github"></i> Gitboster
            </h1>
            <p class="lead mb-5">
                Boost your GitHub activity with automated commits.<br>
                Schedule commits across date ranges and maintain consistent activity.
            </p>
            
            <% if (!user) { %>
                <a href="/auth/github" class="btn btn-github btn-lg">
                    <i class="fab fa-github"></i> Sign in with GitHub
                </a>
            <% } else { %>
                <a href="/dashboard" class="btn btn-github btn-lg">
                    <i class="fas fa-tachometer-alt"></i> Go to Dashboard
                </a>
            <% } %>
        </div>
    </div>

    <div class="container my-5">
        <div class="row">
            <div class="col-md-4">
                <div class="feature-card text-center text-white">
                    <i class="fas fa-calendar-alt fa-3x mb-3"></i>
                    <h4>Date Range Selection</h4>
                    <p>Choose specific date ranges for your commit activity. Perfect for maintaining consistent GitHub streaks.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center text-white">
                    <i class="fas fa-code-branch fa-3x mb-3"></i>
                    <h4>Smart Commit Messages</h4>
                    <p>Automatically generate meaningful commit messages from a curated list of professional options.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center text-white">
                    <i class="fas fa-cogs fa-3x mb-3"></i>
                    <h4>Customizable Frequency</h4>
                    <p>Set how many commits per day you want. Control your GitHub activity level with precision.</p>
                </div>
            </div>
        </div>
    </div>

    <footer class="text-center text-white py-4">
        <div class="container">
            <p>&copy; 2024 Gitboster. Boost your GitHub presence responsibly.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>